{
  "name": "trace-workbench",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Shared Windows computer tools for AI agents.",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "bin": {
    "trace-workbench": "bin/trace.cjs"
  },
  "scripts": {
    "trace": "node bin/trace.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:mcp": "node scripts/smoke-mcp.cjs",
    "check": "node scripts/check.cjs",
    "computer:setup": "node scripts/setup-computer.cjs",
    "computer:config": "node scripts/configure-computer.cjs",
    "computer:doctor": "node bin/trace.cjs computer doctor",
    "computer:mcp": "node bin/trace.cjs computer mcp",
    "test:computer:mcp": "node scripts/smoke-computer-mcp.cjs",
    "test:computer:live": "node scripts/smoke-computer-live.cjs --live"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "rea-agents": "6.7.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
